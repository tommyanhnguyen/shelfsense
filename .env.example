MQTT_URL=mqtt://localhost:1883
MONGODB_URI=mongodb://localhost:27017/shelfsense
DOCKER_MONGODB_URI=
PORT=3000
DEBOUNCE_MS=800
TEMPERATURE_LIMIT_C=5
TEMPERATURE_SAMPLES=2
TEMPERATURE_HYSTERESIS_C=0.8
AUTO_APPROVE_UNDER=150
SAFETY_DAYS=1

MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
EVENT_SIGNING_REQUIRED=false
EVENT_SIGNING_SECRET=
API_AUTH_REQUIRED=false
API_AUTH_SECRET=
NODE_RED_ADMIN_PASSWORD_HASH=

# Load run: raw shelf readings per second and seconds to run. Two readings make one stock event.
RATE=100
DURATION=60
STORES=20
SHELVES_PER_STORE=50
# Set RUN_ID for a named run. Leave empty to create a new ID.
RUN_ID=
STARTUP_DELAY_MS=0
